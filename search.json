tHub :","code":"install.packages(\"figletr\") # install.packages(\"devtools\") devtools::install_github(\"jbkunst/figletr\")"},{"path":"https://jkunst.com/figletr/index.html","id":"usage","dir":"","previous_headings":"","what":"Usage","title":"A figlet font parser","text":"","code":"library(figletr)  figlet(Sys.Date()) #>   ____     ___    ____     ___             ___    _  _             ____     ___ #>  |___ \\   / _ \\  |___ \\   / _ \\           / _ \\  | || |           |___ \\   / _ \\ #>    __) | | | | |   __) | | | | |  _____  | | | | | || |_   _____    __) | | (_) | #>   / __/  | |_| |  / __/  | |_| | |_____| | |_| | |__   _| |_____|  / __/   \\__, | #>  |_____|  \\___/  |_____|  \\___/           \\___/     |_|           |_____|    /_/ #>   text <- \"Figlet in R!\"  figlet(text) #>   _____   _           _          _       _             ____    _ #>  |  ___| (_)   __ _  | |   ___  | |_    (_)  _ __     |  _ \\  | | #>  | |_    | |  / _` | | |  / _ \\ | __|   | | | '_ \\    | |_) | | | #>  |  _|   | | | (_| | | | |  __/ | |_    | | | | | |   |  _ <  |_| #>  |_|     |_|  \\__, | |_|  \\___|  \\__|   |_| |_| |_|   |_| \\_\\ (_) #>               |___/  figlet(text, \"banner\") #>  #######                                                       ######   ### #>  #        #   ####   #       ######  #####      #  #    #      #     #  ### #>  #        #  #    #  #       #         #        #  ##   #      #     #  ### #>  #####    #  #       #       #####     #        #  # #  #      ######    # #>  #        #  #  ###  #       #         #        #  #  # #      #   # #>  #        #  #    #  #       #         #        #  #   ##      #    #   ### #>  #        #   ####   ######  ######    #        #  #    #      #     #  ### #>   figlet(text, \"contessa\") #> .___    .    ,         .__  | #> [__ * _ | _ -+-  *._   [__) | #> |   |(_]|(/, |   |[ )  |  \\ * #>      ._|  figlet(text, \"smkeyboard\") #>  ____  ____  ____  ____  ____  ____  _________  ____  ____  _________  ____  ____ #> ||F ||||i ||||g ||||l ||||e ||||t ||||       ||||i ||||n ||||       ||||R ||||! || #> ||__||||__||||__||||__||||__||||__||||_______||||__||||__||||_______||||__||||__|| #> |/__\\||/__\\||/__\\||/__\\||/__\\||/__\\||/_______\\||/__\\||/__\\||/_______\\||/__\\||/__\\|  figlet(text, \"smisome1\") #>     ___       ___       ___       ___       ___       ___            ___       ___            ___ #>    /\\  \\     /\\  \\     /\\  \\     /\\__\\     /\\  \\     /\\  \\          /\\  \\     /\\__\\          /\\  \\ #>   /::\\  \\   _\\:\\  \\   /::\\  \\   /:/  /    /::\\  \\    \\:\\  \\        _\\:\\  \\   /:| _|_        /::\\  \\ #>  /::\\:\\__\\ /\\/::\\__\\ /:/\\:\\__\\ /:/__/    /::\\:\\__\\   /::\\__\\      /\\/::\\__\\ /::|/\\__\\      /::\\:\\__\\ #>  \\/\\:\\/__/ \\::/\\/__/ \\:\\:\\/__/ \\:\\  \\    \\:\\:\\/  /  /:/\\/__/      \\::/\\/__/ \\/|::/  /      \\;:::/  / #>     \\/__/   \\:\\__\\    \\::/  /   \\:\\__\\    \\:\\/  /   \\/__/          \\:\\__\\     |:/  /        |:\\/__/ #>              \\/__/     \\/__/     \\/__/     \\/__/                    \\/__/     \\/__/          \\|__|  figlet(text, \"speed\") #> _______________          ______      _____        _____                ________ ______ #> ___  ____/___(_)_______ ____  /_____ __  /_       ___(_)_______        ___  __ \\___  / #> __  /_    __  / __  __ `/__  / _  _ \\_  __/       __  / __  __ \\       __  /_/ /__  / #> _  __/    _  /  _  /_/ / _  /  /  __// /_         _  /  _  / / /       _  _, _/  /_/ #> /_/       /_/   _\\__, /  /_/   \\___/ \\__/         /_/   /_/ /_/        /_/ |_|  (_) #>                 /____/  figlet(text, \"univers\") #>  #> 88888888888  88               88                           88                   88888888ba   88 #> 88           \"\"               88                ,d         \"\"                   88      \"8b  88 #> 88                            88                88                              88      ,8P  88 #> 88aaaaa      88   ,adPPYb,d8  88   ,adPPYba,  MM88MMM      88  8b,dPPYba,       88aaaaaa8P'  88 #> 88\"\"\"\"\"      88  a8\"    `Y88  88  a8P_____88    88         88  88P'   `\"8a      88\"\"\"\"88'    88 #> 88           88  8b       88  88  8PP\"\"\"\"\"\"\"    88         88  88       88      88    `8b    \"\" #> 88           88  \"8a,   ,d88  88  \"8b,   ,aa    88,        88  88       88      88     `8b   aa #> 88           88   `\"YbbdP\"Y8  88   `\"Ybbd8\"'    \"Y888      88  88       88      88      `8b  88 #>                   aa,    ,88 #>                    \"Y8bbdP\"  figlet(text, \"sblood\") #>  @@@@@@@@ @@@  @@@@@@@  @@@      @@@@@@@@ @@@@@@@      @@@ @@@  @@@      @@@@@@@  @@@ #>  @@!      @@! !@@       @@!      @@!        @@!        @@! @@!@!@@@      @@!  @@@ @@@ #>  @!!!:!   !!@ !@! @!@!@ @!!      @!!!:!     @!!        !!@ @!@@!!@!      @!@!!@!  !@! #>  !!:      !!: :!!   !!: !!:      !!:        !!:        !!: !!:  !!!      !!: :!! #>   :       :    :: :: :  : ::.: : : :: :::    :         :   ::    :        :   : : :.: #>"},{"path":"https://jkunst.com/figletr/index.html","id":"changing-default-font","dir":"","previous_headings":"","what":"Changing default font","title":"A figlet font parser","text":"","code":"options(figletr.default_font = \"mini\")  figlet(\"Figlet in R!\") #>   _                                    _ #>  |_  o   _   |   _   _|_    o  ._     |_)  | #>  |   |  (_|  |  (/_   |_    |  | |    | \\  o #>          _|  figlet(\"Hello\") #>  #>  |_|   _   |  |   _ #>  | |  (/_  |  |  (_) #>"},{"path":"https://jkunst.com/figletr/index.html","id":"change-printer","dir":"","previous_headings":"","what":"Change printer","title":"A figlet font parser","text":"Example: Using cat instead message can use crayon package combine cat color: README don’t print console colors","code":"# message is the dafault figlet(\"Figlet in R!\") #>   _                                    _ #>  |_  o   _   |   _   _|_    o  ._     |_)  | #>  |   |  (_|  |  (/_   |_    |  | |    | \\  o #>          _|  options(figletr.printer = cat)  figlet(\"Figlet in R!\") #>   _                                    _      #>  |_  o   _   |   _   _|_    o  ._     |_)  |  #>  |   |  (_|  |  (/_   |_    |  | |    | \\  o  #>          _|  # revert  options(figletr.printer = message) library(figletr) library(crayon)  green_cat <- function(...) cat(green(...))  options(figletr.printer = green_cat)  figlet(\"This is green\")   # Fancy example from crayon ivory <- make_style(\"ivory\") bgMaroon <- make_style(\"maroon\", bg = TRUE) fancy <- combine_styles(ivory, bgMaroon)  fancy_cat <- function(...) cat(fancy(...))  options(figletr.printer = fancy_cat)  figlet(\"Oh! I'm fancy\", font = \"standard\")"},{"path":[]},{"path":"https://jkunst.com/figletr/index.html","id":"fonts","dir":"","previous_headings":"Extra","what":"Fonts","title":"A figlet font parser","text":"Info available fonts:","code":"dplyr::glimpse(figletr::fonts) #> Rows: 148 #> Columns: 8 #> $ font               <chr> \"3-d\", \"3x5\", \"5lineoblique\", \"acrobatic\", \"alli... #> $ baseline           <dbl> 8, 4, 5, 9, 7, 7, 5, 5, 7, 8, 7, 7, 7, 8, 5, 6, ... #> $ comment_lines      <dbl> 1, 4, 2, 15, 3, 4, 12, 16, 12, 3, 3, 3, 2, 2, 23... #> $ heigth             <dbl> 8, 6, 7, 12, 7, 7, 7, 6, 8, 8, 7, 7, 8, 8, 6, 8,... #> $ max_length         <dbl> 20, 6, 20, 25, 26, 26, 10, 10, 54, 20, 20, 20, 2... #> $ old_layout         <dbl> -1, -1, 15, 0, 32, 32, -1, 16, 0, -1, -1, -1, -1... #> $ author             <chr> \"Daniel Henninger\", \"Richard Kirk & Daniel Cabez... #> $ font_creation_date <chr> \"\", \"\", \"1995/01\", \"1994/08\", \"1994/06\", \"1994/0..."},{"path":"https://jkunst.com/figletr/index.html","id":"demo","dir":"","previous_headings":"Extra","what":"Demo","title":"A figlet font parser","text":"","code":"figlet_demo(msg = \"Text to test\")"},{"path":"https://jkunst.com/figletr/index.html","id":"parser","dir":"","previous_headings":"Extra","what":"Parser","title":"A figlet font parser","text":"","code":"path_to_font <- system.file(paste0(\"fonts/contessa.flf\"), package = \"figletr\") path_to_font #> [1] \"C:/Users/Joshua/Documents/R/win-library/3.6/figletr/fonts/contessa.flf\"  font <- figletr::parse_font(path_to_font)  str(head(font)) #> List of 6 #>  $  : chr [1:4] \"  \" \"  \" \"  \" \"  \" #>  $ !: chr [1:4] \" | \" \" | \" \" * \" \"   \" #>  $ \": chr [1:4] \"* * \" \"` ` \" \"    \" \"    \" #>  $ #: chr [1:4] \"_|_|_ \" \"_|_|_ \" \" | |  \" \"      \" #>  $ $: chr [1:4] \" _;_. \" \"(_|_  \" \"._|_) \" \"  `   \" #>  $ %: chr [1:4] \"* / \" \" /  \" \"/ * \" \"    \"  R <- font[[\"R\"]]  R #> [1] \".__ \"  \"[__)\"  \"|  \\\\\" \"    \"  for(i in 1:length(R)) message(R[i]) #> .__ #> [__) #> |  \\ #>"},{"path":"https://jkunst.com/figletr/index.html","id":"related-work","dir":"","previous_headings":"","what":"Related work","title":"A figlet font parser","text":"%>% OMG! swear checked see previous implementation figlet fonts R. https://github.com/wrathematics/Rfiglet Uses C command line figlet shiny app! https://github.com/richfitz/rfiglet can package offer?: possibily change/fix default font. Relative simple integration {crayon} package. figlet font parser. can obtain character list every character.","code":""},{"path":"https://jkunst.com/figletr/reference/figlet.html","id":null,"dir":"Reference","previous_headings":"","what":"Write a message with figlet fonts — figlet","title":"Write a message with figlet fonts — figlet","text":"Write message figlet fonts","code":""},{"path":"https://jkunst.com/figletr/reference/figlet.html","id":"ref-usage","dir":"Reference","previous_headings":"","what":"Usage","title":"Write a message with figlet fonts — figlet","text":"","code":"figlet(msg, font = getOption(\"figletr.default_font\"))"},{"path":"https://jkunst.com/figletr/reference/figlet.html","id":"arguments","dir":"Reference","previous_headings":"","what":"Arguments","title":"Write a message with figlet fonts — figlet","text":"msg message. object can converted character. font string specifying font use, option available fonts (`figletr::fonts`) parameter used path use external figlet fonts.","code":""},{"path":"https://jkunst.com/figletr/reference/figlet.html","id":"ref-examples","dir":"Reference","previous_headings":"","what":"Examples","title":"Write a message with figlet fonts — figlet","text":"","code":"figlet(Sys.Date()) #>   ____     ___    ____     __              ___    _____           _   _____  #>  |___ \\   / _ \\  |___ \\   / /_            / _ \\  |___  |         / | |___ /  #>    __) | | | | |   __) | | '_ \\   _____  | | | |    / /   _____  | |   |_ \\  #>   / __/  | |_| |  / __/  | (_) | |_____| | |_| |   / /   |_____| | |  ___) | #>  |_____|  \\___/  |_____|  \\___/           \\___/   /_/            |_| |____/  #>                                                                               text <- \"Figlet in R!\"  figlet(text) #>   _____   _           _          _       _             ____    _  #>  |  ___| (_)   __ _  | |   ___  | |_    (_)  _ __     |  _ \\  | | #>  | |_    | |  / _` | | |  / _ \\ | __|   | | | '_ \\    | |_) | | | #>  |  _|   | | | (_| | | | |  __/ | |_    | | | | | |   |  _ <  |_| #>  |_|     |_|  \\__, | |_|  \\___|  \\__|   |_| |_| |_|   |_| \\_\\ (_) #>               |___/                                                figlet(text, \"banner\") #>  #######                                                       ######   ###  #>  #        #   ####   #       ######  #####      #  #    #      #     #  ###  #>  #        #  #    #  #       #         #        #  ##   #      #     #  ###  #>  #####    #  #       #       #####     #        #  # #  #      ######    #   #>  #        #  #  ###  #       #         #        #  #  # #      #   #         #>  #        #  #    #  #       #         #        #  #   ##      #    #   ###  #>  #        #   ####   ######  ######    #        #  #    #      #     #  ###  #>"},{"path":"https://jkunst.com/figletr/reference/figlet_demo.html","id":null,"dir":"Reference","previous_headings":"","what":"Test and show the available fonts in the package — figlet_demo","title":"Test and show the available fonts in the package — figlet_demo","text":"Test show available fonts package","code":""},{"path":"https://jkunst.com/figletr/reference/figlet_demo.html","id":"ref-usage","dir":"Reference","previous_headings":"","what":"Usage","title":"Test and show the available fonts in the package — figlet_demo","text":"","code":"figlet_demo(msg = \"Figlet in R!\")"},{"path":"https://jkunst.com/figletr/reference/figlet_demo.html","id":"arguments","dir":"Reference","previous_headings":"","what":"Arguments","title":"Test and show the available fonts in the package — figlet_demo","text":"msg string test fonts","code":""},{"path":"https://jkunst.com/figletr/reference/font_info.html","id":null,"dir":"Reference","previous_headings":"","what":"Parse the header of a figlet font — font_info","title":"Parse the header of a figlet font — font_info","text":"Parse header figlet font","code":""},{"path":"https://jkunst.com/figletr/reference/font_info.html","id":"ref-usage","dir":"Reference","previous_headings":"","what":"Usage","title":"Parse the header of a figlet font — font_info","text":"","code":"font_info(path = \"inst/fonts/basic.flf\")"},{"path":"https://jkunst.com/figletr/reference/font_info.html","id":"arguments","dir":"Reference","previous_headings":"","what":"Arguments","title":"Parse the header of a figlet font — font_info","text":"path font path.","code":""},{"path":"https://jkunst.com/figletr/reference/fonts.html","id":null,"dir":"Reference","previous_headings":"","what":"Details of available font — fonts","title":"Details of available font — fonts","text":"dataset containing information fonts figletr package.","code":""},{"path":"https://jkunst.com/figletr/reference/fonts.html","id":"ref-usage","dir":"Reference","previous_headings":"","what":"Usage","title":"Details of available font — fonts","text":"","code":"fonts"},{"path":"https://jkunst.com/figletr/reference/fonts.html"